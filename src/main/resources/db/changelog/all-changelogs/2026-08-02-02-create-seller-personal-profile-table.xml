<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-seller-personal-profile-table" author="Raktim">
        <createTable tableName="seller_personal_profiles">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" />
            </column>

            <column name="application_id" type="uuid">
                <constraints
                        nullable="false"
                        unique="true"
                        referencedTableName="seller_applications"
                        referencedColumnNames="id"
                        foreignKeyName="fk_seller_application_respective_certification"
                />
            </column>

            <column name="display_name" type="varchar(100)">
                <constraints nullable="false" />
            </column>

            <column name="professional_headline" type="varchar(120)">
                <constraints nullable="false" />
            </column>

            <column name="description" type="varchar(600)">
                <constraints nullable="false" />
            </column>

            <column name="country" type="varchar(25)">
                <constraints nullable="false" />
            </column>

            <column name="phone_number" type="varchar(30)">
                <constraints nullable="false" />
            </column>

            <column
                    name="created_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP"
            >
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>