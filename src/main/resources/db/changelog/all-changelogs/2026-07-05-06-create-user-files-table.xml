<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-user-files-table" author="Raktim">

        <createTable tableName="user_files">

            <!-- BaseEntity -->

            <column name="id"
                    type="UUID"
                    defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"
                             nullable="false"/>
            </column>

            <column
                    name="created_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP"
            >
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <!-- UserFileEntity -->

            <column name="s3_key"
                    type="VARCHAR(512)">
                <constraints nullable="false"
                             unique="true"/>
            </column>

            <column name="original_file_name"
                    type="VARCHAR(255)"/>

            <column name="content_type"
                    type="VARCHAR(100)"/>

            <column name="file_size"
                    type="BIGINT"/>

            <column name="type"
                    type="VARCHAR(30)"
                    defaultValue="PROFILE_PICTURE">
                <constraints nullable="false"/>
            </column>

            <column name="status"
                    type="VARCHAR(20)"
                    defaultValue="UPLOADING">
                <constraints nullable="false"/>
            </column>

            <column name="user_id"
                    type="UUID">
                <constraints nullable="true"
                             referencedTableName="users"
                             referencedColumnNames="id"
                             foreignKeyName="fk_user_files_user"/>
            </column>

        </createTable>

        <!-- Indexes -->

        <createIndex
                indexName="idx_user_files_user_id"
                tableName="user_files">
            <column name="user_id"/>
        </createIndex>

        <createIndex
                indexName="idx_user_files_s3_key"
                tableName="user_files"
                unique="true">
            <column name="s3_key"/>
        </createIndex>

    </changeSet>
</databaseChangeLog>