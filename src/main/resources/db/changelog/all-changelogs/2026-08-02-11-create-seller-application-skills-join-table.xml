<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-seller-application-skills-join-table" author="Raktim">
        <createTable tableName="seller_application_skills">
            <column name="application_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="skill_id" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="seller_application_skills"
                columnNames="application_id, skill_id"
                constraintName="pk_seller_application_skills"/>

        <addForeignKeyConstraint
                constraintName="fk_seller_application_skills_application"
                baseTableName="seller_application_skills"
                baseColumnNames="application_id"
                referencedTableName="seller_applications"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                constraintName="fk_seller_application_skills_skill"
                baseTableName="seller_application_skills"
                baseColumnNames="skill_id"
                referencedTableName="skills"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex
                tableName="seller_application_skills"
                indexName="idx_seller_application_skills_skill_id">
            <column name="skill_id"/>
        </createIndex>

        <rollback>
            <dropTable
                    tableName="seller_application_skills"
                    cascadeConstraints="true"/>
        </rollback>
    </changeSet>
</databaseChangeLog>