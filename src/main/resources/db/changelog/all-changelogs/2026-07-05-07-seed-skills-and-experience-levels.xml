<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="seed-skills" author="Raktim">
        <loadData
                tableName="skills"
                file="db/data/skills.csv"
                separator=","
                encoding="UTF-8">
            <column name="skill" type="varchar(15)"/>
        </loadData>
    </changeSet>

    <changeSet id="seed-experience-levels" author="Raktim">
        <loadData
                tableName="experience_level"
                file="db/data/experience-levels.csv"
                separator=","
                encoding="UTF-8"
        >
            <column name="experience_level" type="varchar(30)" />
        </loadData>

    </changeSet>
</databaseChangeLog>